{% extends "base.njk" %}

{% block main %}

  <section class="hero-photo hero-mod">
    <img class="hero-bg" src="{{ root }}assets/img/moderovani-hero.jpg" srcset="{{ root }}assets/img/moderovani-hero-900.jpg 900w, {{ root }}assets/img/moderovani-hero.jpg 1800w" sizes="100vw" alt="Lukáš Havránek moderuje konferenci před plným sálem" width="1800" height="1199" fetchpriority="high">
    <div class="wrap">
      <div class="hero-txt">
        <span class="eyebrow">Moderování</span>
        <h1>Moderuji konference, rozhovory i&nbsp;diskuse</h1>
        <p class="sub">Moderuji různé formáty: konference, společenské akce, rozhovory na pódiu před publikem, panelové diskuse i&nbsp;podcast.</p>
        <div class="hero-btns">
          <a href="{{ root }}kontakt/" class="btn btn-primary">Poptat moderování</a>
          <a href="#formaty" class="btn btn-outline-light">Formáty, které moderuji</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block bg-mint">
    <div class="wrap">
      <div class="center" id="formaty"><h2>Formáty, které moderuji</h2></div>
      <div class="why-grid formats">
        <div class="why-card"><h3>Konference</h3><p>Provázím publikum celým programem a&nbsp;propojuji jednotlivé řečníky.</p><p class="ex">Témata: leadership, osobní rozvoj, AI.</p></div>
        <div class="why-card"><h3>Rozhovory na pódiu</h3><p>Živý rozhovor s&nbsp;hostem přímo před publikem.</p><p class="ex">Například s&nbsp;Martinem Cíglerem, zakladatelem a&nbsp;spolumajitelem skupiny Seyfor, nebo s&nbsp;Danielou Peškovou, členkou představenstva České spořitelny.</p></div>
        <div class="why-card"><h3>Panelové diskuse</h3><p>Debata několika hostů s&nbsp;odlišnými pohledy na jedno téma.</p><p class="ex">Například KRNAP versus skialpinisté.</p></div>
        <div class="why-card"><h3>Společenské akce</h3><p>Večer, kde jde o&nbsp;atmosféru stejně jako o&nbsp;program.</p><p class="ex">Například premiéra dokumentu o&nbsp;Beskydské sedmičce.</p></div>
        <div class="why-card"><h3>Podcast naHoru.tv</h3><p>Rozhovory s&nbsp;lidmi z&nbsp;horského prostředí v&nbsp;<a href="https://www.youtube.com/c/nahorutv" target="_blank" rel="noopener">podcastu</a>, který jsem spoluzaložil.</p><p class="ex">Přes 70 rozhovorů, například s&nbsp;Radkem Jarošem nebo Alenou Zárybnickou.</p></div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="center"><h2>Z akcí</h2></div>
      <div class="gallery">
        <figure><img src="{{ root }}assets/img/moderovani-01.jpg" alt="Lukáš Havránek s mikrofonem na pódiu" width="900" height="600" loading="lazy"></figure>
        <figure><img src="{{ root }}assets/img/moderovani-07.jpg" alt="Lukáš Havránek moderuje panelovou diskusi" width="900" height="600" loading="lazy"></figure>
        <figure><img src="{{ root }}assets/img/moderovani-08.jpg" alt="Lukáš Havránek uvádí premiéru dokumentu o Beskydské sedmičce" width="900" height="495" loading="lazy"></figure>
        <figure><img src="{{ root }}assets/img/moderovani-09.jpg" alt="Lukáš Havránek vede rozhovor pro naHoru.tv před publikem" width="900" height="600" loading="lazy"></figure>
        <figure><img src="{{ root }}assets/img/moderovani-05.jpg" alt="Lukáš Havránek na osvětleném pódiu" width="900" height="600" loading="lazy"></figure>
        <figure><img src="{{ root }}assets/img/moderovani-03.jpg" alt="Lukáš Havránek na pódiu konference" width="900" height="600" loading="lazy"></figure>
      </div>
    </div>
  </section>

  <section class="block tight" style="padding-bottom:90px">
    <div class="wrap">
      <div class="bg-forest" style="border-radius:var(--radius);padding:52px 46px;text-align:center">
        <h2 style="margin-bottom:10px">Hledáte moderátora?</h2>
        <p style="opacity:.9;max-width:52ch;margin:0 auto 26px">Napište mi termín, místo a typ akce. Ozvu se zpět a domluvíme podrobnosti.</p>
        <a href="{{ root }}kontakt/" class="btn btn-primary">Poptat moderování</a>
      </div>
    </div>
  </section>
