        <figure><img src="{{ root }}assets/img/moderovani-02.jpg" alt="Lukáš Havránek v divadelním sále" width="900" height="600" loading="lazy"></figure>
        <figure><img src="{{ root }}assets/img/moderovani-03.jpg" alt="Lukáš Havránek na pódiu konference" width="900" height="600" loading="lazy"></figure>
        <figure><img src="{{ root }}assets/img/moderovani-04.jpg" alt="Lukáš Havránek na pódiu s tabletem" width="900" height="600" loading="lazy"></figure>
        <figure><img src="{{ root }}assets/img/moderovani-05.jpg" alt="Lukáš Havránek na osvětleném pódiu" width="900" height="600" loading="lazy"></figure>
        <figure><img src="{{ root }}assets/img/moderovani-06.jpg" alt="Lukáš Havránek s mikrofonem v sále" width="900" height="600" loading="lazy"></figure>
